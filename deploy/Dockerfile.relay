FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -buildvcs=false -ldflags="-s -w" -o /peerlink-relay ./cmd/peerlink-relay

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /peerlink-relay /app/peerlink-relay
EXPOSE 8443 3478/udp
ENTRYPOINT ["/app/peerlink-relay"]
CMD ["-listen", ":8443", "-stun", ":3478"]
