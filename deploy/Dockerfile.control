FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -buildvcs=false -ldflags="-s -w" -o /peerlink-control ./cmd/peerlink-control

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /peerlink-control /app/peerlink-control
EXPOSE 8080
ENTRYPOINT ["/app/peerlink-control"]
CMD ["serve"]
